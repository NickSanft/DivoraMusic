{
  "name": "divora-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Divora — artist site. Single-page anchor-scrolled, audio-reactive prism visualizer, hidden /lab.",
  "homepage": "https://nicksanft.github.io/DivoraMusic/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickSanft/DivoraMusic.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:update-snapshots": "playwright test --update-snapshots",
    "og:generate": "vite build && node scripts/generate-og.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.16.0",
    "@fontsource/anton": "^5.2.7",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter-tight": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
